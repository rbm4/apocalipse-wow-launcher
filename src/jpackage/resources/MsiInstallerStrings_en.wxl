<?xml version="1.0" encoding="utf-8"?>
<!-- jpackage requires this resource filename; the Culture attribute controls the MSI UI language. -->
<WixLocalization Culture="pt-BR" xmlns="http://schemas.microsoft.com/wix/2006/localization" Codepage="1252">
  <String Id="MainFeatureTitle">Apocalipse BR Launcher</String>
  <String Id="DowngradeErrorMessage">Uma versão mais recente do [ProductName] já está instalada. Não é possível instalar uma versão anterior. O instalador será encerrado.</String>
  <String Id="DisallowUpgradeErrorMessage">Uma versão anterior do [ProductName] já está instalada. Não é possível atualizar para uma versão mais recente. O instalador será encerrado.</String>

  <String Id="ShortcutPromptDlg_Title">Instalação do [ProductName]</String>
  <String Id="ShortcutPromptDlgTitle">{\WixUI_Font_Title}Atalhos</String>
  <String Id="ShortcutPromptDlgBannerBitmap">WixUI_Bmp_Banner</String>
  <String Id="ShortcutPromptDlgDescription">Selecione os atalhos que deseja criar.</String>
  <String Id="ShortcutPromptDlgDesktopShortcutControlLabel">Criar atalho na Área de Trabalho</String>
  <String Id="ShortcutPromptDlgStartMenuShortcutControlLabel">Criar atalho no Menu Iniciar</String>

  <String Id="InstallDirNotEmptyDlg_Title">Instalação do [ProductName]</String>
  <String Id="InstallDirNotEmptyDlgInstallDirExistMessage">A pasta [INSTALLDIR] já existe. Deseja instalar nela mesmo assim?</String>

  <String Id="ContextMenuCommandLabel">Abrir com [ProductName]</String>

  <String Id="OsConditionMessage">[ProductName] [ProductVersion] não é compatível com esta versão do Windows.</String>
</WixLocalization>
